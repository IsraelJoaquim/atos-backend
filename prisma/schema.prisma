generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Role {
  admin
  tecnico
  usuario
}

enum Status {
  aberto
  em_andamento
  finalizado
}

model Tenants {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    Users[]
  chamados Chamados[]
}

model Users {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  email              String   @unique
  password           String
  role               Role
  active             Boolean  @default(true)
  verification_token String?
  email_verified     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenants         @relation(fields: [tenantId], references: [id])
  chamados      Chamados[]
  movimentacoes Movimentacoes[]
}

model Chamados {
  id             String   @id @default(uuid())
  ticket         String   @unique
  tenantId       String
  title          String
  description    String
  status         Status   @default(aberto)
  userId         String
  assignedToId   String?
  assignedToName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenants         @relation(fields: [tenantId], references: [id])
  user          Users           @relation(fields: [userId], references: [id])
  movimentacoes Movimentacoes[]
}

model Movimentacoes {
  id           String   @id @default(uuid())
  ticketId     String
  tecnicoId    String?
  tecnicoNome  String?
  statusAntes  Status
  statusDepois Status
  observacao   String?
  createdAt    DateTime @default(now())

  ticket  Chamados @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tecnico Users?   @relation(fields: [tecnicoId], references: [id])
}
